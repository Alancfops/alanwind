{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!pnpm-lock.yaml", "!**/*.md", "!.claude/worktrees"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/**", "apps/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "core is pure: no framework imports (D74).",
                  "react-native": "core is pure: no framework imports (D74)."
                },
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "core is pure: no platform APIs (D74)."
                  },
                  {
                    "group": ["@alanwind/*"],
                    "message": "core depends on no other package (D74)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/native/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@alanwind/css": "emitters never import each other (D74)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [".github/scripts/**"],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      },
      "formatter": {
        "lineWidth": 100
      }
    }
  ],
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
