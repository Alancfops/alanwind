{
  "name": "@alanwind/native",
  "version": "0.0.0",
  "description": "alanwind React Native emitter and components.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:components",
    "test:unit": "vitest run --passWithNoTests",
    "test:components": "jest --passWithNoTests"
  },
  "dependencies": {
    "@alanwind/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-native": "^0.88.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "19.3.2",
    "expo": "58.0.26",
    "jest": "^30.5.2",
    "jest-expo": "58.0.15",
    "react": "19.3.0",
    "react-native": "0.88.1"
  }
}
